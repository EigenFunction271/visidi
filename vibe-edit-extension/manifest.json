{
  "manifest_version": 3,
  "name": "Visidi",
  "version": "0.2.0",
  "description": "Click elements on your local dev site to capture edit prompts for AI coding agents. Optional auto-apply via Claude Code.",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "file:///*",
    "ws://localhost/*",
    "ws://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Visidi",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
